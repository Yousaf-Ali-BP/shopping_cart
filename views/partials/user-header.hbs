<header>
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
        <div class="container-fluid">
            <a class="navbar-brand mt-2" href="#">Shopping Cart</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto my-3 mb-lg-0">
                    <li class="nav-item mb-3 mb-lg-0 me-lg-3">
                        <a class="nav-link active" aria-current="page" href="/">Products</a>
                    </li>

                    <li class="nav-item mb-2 mb-lg-0 me-lg-3">
                        <div class="position-relative d-inline-block">
                            <a class="nav-link" href="/cart">
                                <i class="bi bi-cart" style="font-size: 1.4rem;"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="cart-count">{{cartCount}}</span>
                            </a>
                        </div>
                    </li>

                    {{#if user}}
                        <li class="nav-item">
                            <a class="nav-link" href="#">Orders</a>
                        </li>
                    {{/if}}
                </ul>
                <div class="dropdown">
                    <button class="btn btn-success dropdown-toggle" type="button" id="dropdownMenuButton"
                            data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        {{#if user}}
                            {{user.name}}
                        {{else}}
                            Account
                        {{/if}}
                    </button>
                    <div class="dropdown-menu bg-success-subtle" aria-labelledby="dropdownMenuButton">
                        {{#if user}}
                            <a class="dropdown-item text-success-emphasis" href="/logout">Log Out</a>
                        {{else}}
                            <a class="dropdown-item text-success-emphasis" href="/login">Log In</a>
                            <a class="dropdown-item text-success-emphasis" href="/signup">Sign Up</a>
                        {{/if}}

                    </div>
                </div>
            </div>
        </div>
    </nav>
</header>