<section>
    <div class="container">
        <div class="row mt-5">
            <div class="mb-5">
                <a href="/admin/add-product" class="btn btn-success">Add Product</a>
            </div>
            <form class="d-flex" role="search">
                <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search"/>
                <button class="btn btn-outline-success" type="submit">Search</button>
            </form>
            <table class="table mt-3">
                <thead>
                <tr>
                    <th scope="col">No</th>
                    <th scope="col">Name</th>
                    <th scope="col">Price</th>
                    <th scope="col">Category</th>
                    <th scope="col">Description</th>
                    <th scope="col">Image</th>
                </tr>
                </thead>
                <tbody>
                {{#each products}}
                    <tr>
                        <th scope="row">{{inc @index}}</th>
                        <td>{{this.name}}</td>
                        <td>{{this.price}}</td>
                        <td>{{this.category}}</td>
                        <td>{{this.description}}</td>
                        <td><img style="width: 45px;height: 60px" src="/product-images/{{this._id}}.webp"></td>
                        <td>
                            <a href="admin/edit-product/{{this._id}}" class="btn btn-primary">Edit</a>
                        </td>
                        <td>
                            <a href="/admin/delete-product/{{this._id}}" class="btn btn-danger" onclick="return confirm('Delete {{this.name}}? This action cannot be undone.')">Delete</a>
                        </td>
                    </tr>
                {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</section>