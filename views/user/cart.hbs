<section>
    <div class="container">
        <div class="row">
            <div class="col-12 my-5">

                <div class="card bg-light">
                    <div class="card-header">
                        <h4>Shopping Cart</h4>
                    </div>
                    <div class="card-body m-2">

                        {{#each products}}

                            <div class="card mb-3" id="cartProduct-{{this.item}}">
                                <div class="row g-0">
                                    <div class="col-4 col-md-2 col-xxl-1 d-flex align-items-center justify-content-center">
                                        <img src="/product-images/{{this.item}}.webp" class='' alt="..."
                                             style="height:8rem;width:6rem;">
                                    </div>
                                    <div class="col-8 col-md-10 col-xxl-11">
                                        <div class="card-body d-flex justify-content-between align-items-center">
                                            <div>
                                                <h5 class="card-title">{{this.name}}</h5>
                                                <p class="card-text fs-6">{{this.description}}</p>
                                                <h6 class="fw-bold card-text my-3">{{this.formattedPrice}}</h6>
                                                <button class="btn btn-primary fw-bold btn-minus"
                                                        data-id="{{this.item}}">-
                                                </button>
                                                <span class="mx-2"
                                                      id="cart-count-{{this.item}}">{{this.quantity}}</span>
                                                <button class="btn btn-primary fw-bold btn-plus"
                                                        data-id="{{this.item}}">+
                                                </button>
                                            </div>
                                            <div>
                                                <button class="btn btn-danger btn-remove-cart" data-id="{{this.item}}">
                                                    <i class="bi bi-trash3-fill"></i></button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        {{/each}}

                        <div class="float-end">
                            <h6 class="card-text my-3">Total Amount (<span id="total-quantity">{{data.totalQuantity}}</span> item) : <span class="fw-bold" id="total-amount">{{data.formattedPrice}}</span></h6>
                            <a href="/place-order" class="btn btn-success fs-5">Place Order</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>