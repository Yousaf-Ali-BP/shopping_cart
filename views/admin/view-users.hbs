<section>
    <div class="container" style="margin-top:6rem">
        <div class="row mt-5">
            <table class="table mt-3">
                <thead>
                <tr>
                    <th scope="col">No</th>
                    <th scope="col">Id</th>
                    <th scope="col">Name</th>
                    <th scope="col">Email</th>
                </tr>
                </thead>
                <tbody>
                {{#each data}}
                    <tr>
                        <td>{{inc @index}}</td>
                        <td>{{this._id}}</td>
                        <td>{{this.name}}</td>
                        <td>{{this.email}}</td>
                    </tr>
                {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</section>