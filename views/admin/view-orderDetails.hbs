<section>
    <div class="container">
        <div class="row">
            <div class="col-md-8 mt-1">
                <div class="card mb-5 p-3">
                    <div class="card-header border-0">
                        <h3>Order ID :#{{orderDetails.shortId}}</h3>
                        <p class="text-secondary">{{orderDetails.formattedDate}} at {{orderDetails.formattedTime}}</p>
                    </div>
                    <div class="card-body mt-3">

                        {{#each orderDetails.products}}

                            <div class="card mb-3">
                                <div class="row g-0">
                                    <div class="col-4 col-md-2 col-xxl-1 d-flex align-items-center justify-content-center">
                                        <img src="/product-images/{{this.item}}.webp" alt="..."
                                             style="height:4rem;width:3rem;">
                                    </div>
                                    <div class="col-8 col-md-10 col-xxl-11">
                                        <div class="card-body d-flex justify-content-between align-items-center">
                                            <div>
                                                <h5 class="card-title">{{this.name}}</h5>
                                                <div class="d-flex justify-content-start align-items-center">
                                                    <p class="card-text mb-0">{{this.formattedPrice}}
                                                        x {{this.quantity}}</p>
                                                    <p class="card-text mx-5">{{this.formattedTotalPrice}}</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        {{/each}}



                        <div class="card mt-5">
                            <div class="card-body p-3">
                                <h5 class="card-title mt">Order Summary</h5>
                                {{#if (eq orderDetails.paymentStatus 'Payment Pending')}}
                                    <p class="card-subtitle mb-3 badge bg-warning-subtle text-warning-emphasis fw-bold p-2 rounded-3">{{orderDetails.paymentStatus}}</p>
                                {{else if (eq orderDetails.paymentStatus 'Payment Successful')}}
                                    <p class="card-subtitle mb-3 badge bg-success-subtle text-success-emphasis fw-bold p-2 rounded-3">{{orderDetails.paymentStatus}}</p>
                                {{else if (eq orderDetails.paymentStatus 'Payment Failed')}}
                                    <p class="card-subtitle mb-3 badge bg-danger-subtle text-danger-emphasis fw-bold p-2 rounded-3">{{orderDetails.paymentStatus}}</p>
                                {{/if}}
                                <table class="table">
                                    <tbody>
                                    <tr>
                                        <td>Subtotal</td>
                                        {{#if (eq orderDetails.productNo 1)}}
                                            <td>{{orderDetails.productNo}} item</td>
                                        {{else}}
                                            <td>{{orderDetails.productNo}} items</td>
                                        {{/if}}

                                        <td>{{orderDetails.formattedTotalAmount}}</td>
                                    </tr>
                                    <tr>
                                        <td>shipping</td>
                                        <td>Free shipping</td>
                                        <td>0</td>
                                    </tr>
                                    </tbody>
                                    <tfoot>
                                    <tr>
                                        <th scope="col" colspan="">Total</th>
                                        <th scope="col" colspan=""></th>
                                        <th scope="col" colspan="">{{orderDetails.formattedTotalAmount}}</th>
                                    </tr>
                                    </tfoot>
                                </table>

                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-md-4 mt-5">
                <div class="card mb-5">
                    <div class="card-body">
                        <h5 class="card-title text-dark mt-5">Customer</h5>
                        <p class="card-text text-secondary mt-3 m-0"><i class="bi bi-person"></i> {{user.name}}</p>
                        <p class="card-text text-secondary m-0"><i class="bi bi-envelope"></i> {{user.email}}</p>

                        <h5 class="card-title text-dark mt-5">Shipping Address</h5>
                        <p class="card-text text-secondary m-0 mt-3"><i
                                class="bi bi-person"></i> {{orderDetails.deliveryDetails.name}}
                        </p>
                        <p class="card-text text-secondary m-0"><i
                                class="bi bi-telephone"></i> {{orderDetails.deliveryDetails.mobile}}
                        </p>
                        {{#if orderDetails.deliveryDetails.alternativePhone}}
                            <p class="card-text text-secondary m-0"><i
                                    class="bi bi-telephone"></i> {{orderDetails.deliveryDetails.alternativePhone}}</p>
                        {{/if}}
                        <p class="card-text text-secondary m-0"><i
                                class="bi bi-geo-alt"></i> {{orderDetails.deliveryDetails.pinCode}}
                        </p>
                        <p class="card-text text-secondary m-0"><i
                                class="bi bi-house"></i> {{orderDetails.deliveryDetails.address}}</p>
                        {{#if orderDetails.deliveryDetails.landmark}}
                            <p class="card-text text-secondary m-0"><i
                                    class="bi bi-pin-map"></i> {{orderDetails.deliveryDetails.landmark}}</p>
                        {{/if}}
                        <p class="card-text text-secondary m-0 mb-3"><i
                                class="bi bi-map"></i> {{orderDetails.deliveryDetails.state}}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>